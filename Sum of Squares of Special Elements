
class Solution:
    def sumOfSquares(self, nums: List[int]) -> int:
        z = 0
        n = len(nums)

        # Check every position from 1 to n
        for i in range(1, n + 1):

            # Check if the position divides n
            if n % i == 0:

                # Square the element and add it to the sum
                z += nums[i - 1] * nums[i - 1]

        # Return the final sum
        return z
