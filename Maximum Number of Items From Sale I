
class Solution:
    def maximumSaleItems(self, items: List[List[int]], budget: int) -> int:
        dp = [0] * (budget + 1)

        min_price = min(price for factor, price in items)

        for factor, price in items:

            # Count purchased first copy + free copies
            count = sum(
                1 for f, p in items if f % factor == 0
            )

            # 0/1 Knapsack
            for b in range(budget, price - 1, -1):
                dp[b] = max(dp[b], dp[b - price] + count)

        # Buy additional copies using remaining budget
        ans = 0

        for b in range(budget + 1):
            ans = max(ans, dp[b] + (budget - b) // min_price)

        return ans
