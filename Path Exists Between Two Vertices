
class Solution:
    def checkPath(self, adj, src, dest):
        visited = [False] * len(adj)

        stack = [src]
        visited[src] = True

        while stack:
            node = stack.pop()

            if node == dest:
                return True

            for neighbor in adj[node]:
                if not visited[neighbor]:
                    visited[neighbor] = True
                    stack.append(neighbor)

        return False
