T = int(input())

for _ in range(T):
    N, K = map(int, input().split())
    A = list(map(int, input().split()))

    # Remove all occurrences of K
    B = []

    for x in A:
        if x != K:
            B.append(x)

    # Check whether B is a palindrome
    if B == B[::-1]:
        print("Yes")
    else:
        print("No")
