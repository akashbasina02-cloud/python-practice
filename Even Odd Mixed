# Read the number
n = int(input())

# 0 is an even digit
if n == 0:
    print("Even")
else:
    e = 0
    o = 0

    while n > 0:
        d = n % 10

        if d % 2 == 0:
            e += 1
        else:
            o += 1

        n //= 10

    if e == 0:
        print("Odd")
    elif o == 0:
        print("Even")
    else:
        print("Mixed")
