# Function to check prime number
def is_prime(n):
    if n < 2:
        return False
    
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    
    return True

# Function to check palindrome
def is_palindrome(n):
    return str(n) == str(n)[::-1]

# Input
n = int(input())

# Find next prime palindrome number
n += 1

while True:
    if is_prime(n) and is_palindrome(n):
        print(n)
        break
    n += 1
