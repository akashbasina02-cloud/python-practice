
t = int(input())

for _ in range(t):
    n = int(input())
    a = list(map(int, input().split()))

    penalty = {}

    # Store the maximum penalty for each return day
    for i in range(n):
        day = a[i]
        late_days = i + 1

        penalty[day] = late_days

    # Add the maximum penalty for every day
    print(sum(penalty.values()))
