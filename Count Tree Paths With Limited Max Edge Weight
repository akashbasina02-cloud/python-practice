
class Solution:
    def maximumWeight(self, n, edges, queries):
        parent = list(range(n + 1))
        size = [1] * (n + 1)

        def find(x):
            if parent[x] != x:
                parent[x] = find(parent[x])
            return parent[x]

        edges.sort(key=lambda x: x[2])

        q = sorted((x, i) for i, x in enumerate(queries))

        ans = [0] * len(queries)
        total = 0
        j = 0

        for limit, idx in q:
            while j < len(edges) and edges[j][2] <= limit:
                u, v, w = edges[j]

                pu = find(u)
                pv = find(v)

                if pu != pv:
                    total += size[pu] * size[pv]

                    parent[pu] = pv
                    size[pv] += size[pu]

                j += 1

            ans[idx] = total

        return ans
