# Read number of test cases
T = int(input())

for _ in range(T):
    N = int(input())
    S = list(input())

    # Step 1: Swap adjacent characters
    for i in range(0, N - 1, 2):
        S[i], S[i + 1] = S[i + 1], S[i]

    # Step 2: Replace each character
    # a -> z, b -> y, c -> x, ...
    for i in range(N):
        S[i] = chr(ord('a') + ord('z') - ord(S[i]))

    print("".join(S))
