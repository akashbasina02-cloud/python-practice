
class Solution:
    def subarrayXor(self, arr):
        n = len(arr)
        ans = 0

        for i in range(n):
            # Count how many subarrays contain arr[i]
            count = (i + 1) * (n - i)

            # XOR the element only if count is odd
            if count % 2 == 1:
                ans ^= arr[i]

        return ans
