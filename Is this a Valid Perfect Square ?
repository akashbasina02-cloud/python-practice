# Read the input number
num = int(input())

# Binary search range
low = 1
high = num

# Check if there exists an integer whose square is num
while low <= high:
    mid = (low + high) // 2
    square = mid * mid

    if square == num:
        print("true")
        break
    elif square < num:
        low = mid + 1
    else:
        high = mid - 1
else:
    print("false")
