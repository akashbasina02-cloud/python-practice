# Number of test cases
T = int(input())

for _ in range(T):
    # Read size of array
    N = int(input())

    # Read array
    A = list(map(int, input().split()))

    # Find the sum
    total = sum(A)

    # If N is odd, sum can never become 0
    if N % 2 != 0:
        print(-1)

    # If sum is already 0
    elif total == 0:
        print(0)

    # Each flip changes the sum by 2
    else:
        print(abs(total) // 2)
