# Read the total number of elements
n = int(input())

# Read the array elements
l = list(map(int, input().split()))

# Variable to store the count
count = 0

# Check only the middle elements
# (First and last elements cannot be between two elements)
for i in range(1, n - 1):

    # Check if the previous, current, and next elements are all even
    if l[i] % 2 == 0 and l[i - 1] % 2 == 0 and l[i + 1] % 2 == 0:
        count += 1

# Print the final count
print(count)
