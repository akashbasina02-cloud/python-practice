# cook your dish here

n = int(input())

for _ in range(n):
    t = int(input())
    l = list(map(int, input().split()))

    m = 0

    for i in range(t):
        # Buying only one item
        if l[i] > m:
            m = l[i]

        # Buying two items
        for j in range(i + 1, t):
            if l[i] <= l[j]:
                if l[i] + l[j] > m:
                    m = l[i] + l[j]

    print(m)
