
from typing import List

class Solution:
    def minSwaps(self, nums: List[int]) -> int:
        # Calculate the sum of digits of a number
        def digit_sum(num):
            total = 0
            while num > 0:
                total += num % 10
                num //= 10
            return total

        # Sort by digit sum, then by number
        sorted_nums = sorted(nums, key=lambda x: (digit_sum(x), x))

        # Map each number to its target index
        target_index = {num: i for i, num in enumerate(sorted_nums)}

        swaps = 0
        i = 0

        # Count swaps needed to put every number in its correct position
        while i < len(nums):
            if nums[i] != sorted_nums[i]:
                # Find the index where the current number belongs
                j = target_index[nums[i]]

                # Swap the two numbers
                nums[i], nums[j] = nums[j], nums[i]
                swaps += 1
            else:
                i += 1

        return swaps
