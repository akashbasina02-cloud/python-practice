t = int(input())

for _ in range(t):
    n = int(input())
    s = input().strip()

    x = 0
    y = 0

    for move in s:
        if move == 'U':
            y += 1
        elif move == 'D':
            y -= 1
        elif move == 'R':
            x += 1
        elif move == 'L':
            x -= 1

    if (abs(x) == 2 and y == 0) or (abs(y) == 2 and x == 0):
        print("YES")
    else:
        print("NO")
