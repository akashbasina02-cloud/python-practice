t = int(input())

for _ in range(t):
    n, x, y = map(int, input().split())

    # Horizontal cells
    horizontal = n - 1

    # Vertical cells
    vertical = n - 1

    # Diagonal cells
    diagonal = min(x - 1, y - 1) \
             + min(x - 1, n - y) \
             + min(n - x, y - 1) \
             + min(n - x, n - y)

    ans = horizontal + vertical + diagonal

    print(ans)
