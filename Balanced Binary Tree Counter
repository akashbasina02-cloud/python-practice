
class Solution:
    def countBT(self, h):
        MOD = 10**9 + 7

        if h == 0:
            return 1

        if h == 1:
            return 1

        a = 1  # Height 0
        b = 1  # Height 1

        for i in range(2, h + 1):
            c = (b * b + 2 * b * a) % MOD
            a = b
            b = c

        return b
