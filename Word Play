
T = int(input())

for _ in range(T):
    N = int(input())
    words = input().split()

    freq = {}
    pairs = 0

    for word in words:
        key = ''.join(sorted(set(word)))

        if key in freq:
            pairs += freq[key]
            freq[key] += 1
        else:
            freq[key] = 1

    print(pairs)
