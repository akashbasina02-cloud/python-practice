# cook your dish here
T = int(input())

for _ in range(T):
    N = int(input())
    S = input().strip()

    freq = {}

    for ch in S:
        freq[ch] = freq.get(ch, 0) + 1

    possible = True

    for count in freq.values():
        if count % 2 != 0:
            possible = False
            break

    if possible:
        print("YES")
    else:
        print("NO")
