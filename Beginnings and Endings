t = int(input())

for _ in range(t):
    n = int(input())
    a = list(map(int, input().split()))

    if a[0] == a[-1]:
        print(0)
        continue

    ans = float('inf')

    for i in range(n):
        for j in range(i + 1, n):
            if a[i] == a[j]:
                # Move a[i] to the first position
                # and a[j] to the last position
                cost = i + (n - 1 - j)
                ans = min(ans, cost)

                # Move a[j] to the first position
                # and a[i] to the last position
                cost = j + (n - 1 - i)
                ans = min(ans, cost)

    if ans == float('inf'):
        print(-1)
    else:
        print(ans)
