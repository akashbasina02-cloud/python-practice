
t = int(input())

for _ in range(t):
    n = int(input())
    s = input().strip()

    ans = 0
    i = 0

    while i < n:
        j = i

        # Find consecutive occurrences of the same character
        while j < n and s[j] == s[i]:
            j += 1

        # Each operation can transfer 2 consecutive copies
        length = j - i
        ans += (length + 1) // 2

        i = j

    print(ans)
