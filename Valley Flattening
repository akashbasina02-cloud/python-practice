t = int(input())

for _ in range(t):
    n = int(input())
    a = list(map(int, input().split()))

    ans = sum(a)

    # Try every possible valley
    for i in range(1, n - 1):
        if a[i] < a[i - 1] and a[i] < a[i + 1]:
            s = sum(a)

            # Spread to the left
            j = i - 1
            while j >= 0 and a[j] > a[i]:
                s -= (a[j] - a[i])
                j -= 1

            # Spread to the right
            j = i + 1
            while j < n and a[j] > a[i]:
                s -= (a[j] - a[i])
                j += 1

            ans = min(ans, s)

    print(ans)
