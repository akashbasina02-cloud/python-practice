# Read input number
n = int(input())

# Variable to store sum of proper factors
sum_factors = 0

# Find proper factors
for i in range(1, n):
    
    # Check if i is a factor of n
    if n % i == 0:
        sum_factors += i

# Check the type of number
if sum_factors == n:
    print("PERFECT")

elif sum_factors < n:
    print("DEFICIENT")

else:
    print("ABUNDANT")
