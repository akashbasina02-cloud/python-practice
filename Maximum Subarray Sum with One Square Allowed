
class Solution:
    def maximumSubarray(self, arr):
        no_square = arr[0]
        one_square = arr[0] * arr[0]

        ans = max(no_square, one_square)

        for i in range(1, len(arr)):
            x = arr[i]

            new_one_square = max(
                x * x,
                no_square + x * x,
                one_square + x
            )

            no_square = max(x, no_square + x)
            one_square = new_one_square

            ans = max(ans, no_square, one_square)

        return ans
